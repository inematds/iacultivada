            },
            {
              "id": "a2",
              "name": "contexto",
              "value": "COLE AQUI o conteudo de contexto.md seguido de exemplos.md",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "lead",
              "value": "={{ JSON.stringify($json.body) }}",
